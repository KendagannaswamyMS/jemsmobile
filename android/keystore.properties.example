# TEMPLATE ONLY - THIS FILE IS COMMITTED TO GIT. NEVER PUT REAL PASSWORDS HERE.
#
# Copy this to keystore.properties (which is gitignored) and put the real
# values there instead. Paths are relative to the android/ directory.
#
# Create the key with:
#   keytool -genkeypair -v -keystore jems-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias jems-upload
#
storeFile=jems-upload.jks
storePassword=<your-keystore-password>
keyAlias=jems-upload
keyPassword=<your-keystore-password>
